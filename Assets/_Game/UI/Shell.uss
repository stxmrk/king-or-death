.root {
    flex-grow: 1;
    color: rgb(222, 222, 191);
    font-size: 18px;
    -unity-font-definition: url("project://database/Assets/_Game/Art/Fonts/PT_Sans-Web-Regular.ttf");
}

.root .unity-text-element {
    -unity-font-definition: url("project://database/Assets/_Game/Art/Fonts/PT_Sans-Web-Regular.ttf");
}

.root .unity-label {
    color: rgb(222, 222, 191);
    padding: 0;
    margin: 0;
}

.hidden {
    display: none;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    transition-property: opacity, translate;
    transition-duration: 0.28s, 0.28s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

/* Start state for UiFx.Reveal: removed one frame after showing so the transition plays. */
.enter {
    opacity: 0;
    translate: 0 14px;
}

/* Gilded art (tools/art_gen.py Ornament/, black keyed to alpha) */

.emblem {
    background-image: url("project://database/Assets/_Game/Art/UI/Ornament/emblem.png");
    -unity-background-scale-mode: scale-to-fit;
}

.divider {
    height: 28px;
    background-image: url("project://database/Assets/_Game/Art/UI/Ornament/divider.png");
    -unity-background-scale-mode: scale-to-fit;
}

.corner-ornament {
    position: absolute;
    width: 46px;
    height: 46px;
    background-image: url("project://database/Assets/_Game/Art/UI/Ornament/corner.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.corner--tl {
    left: -6px;
    top: -6px;
}

.corner--tr {
    right: -6px;
    top: -6px;
    scale: -1 1;
}

.corner--bl {
    left: -6px;
    bottom: -6px;
    scale: 1 -1;
}

.corner--br {
    right: -6px;
    bottom: -6px;
    scale: -1 -1;
}

.art {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/_Game/Art/UI/menu_bg.png");
    -unity-background-scale-mode: scale-and-crop;
}

.art {
    transition-property: scale, translate;
    transition-duration: 40s, 40s;
    transition-timing-function: ease-in-out-sine, ease-in-out-sine;
}

.art--drift {
    scale: 1.07 1.07;
    translate: -28px 10px;
}

.art--loading {
    background-image: url("project://database/Assets/_Game/Art/UI/loading_bg.png");
}

.fade-left {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/_Game/Art/UI/fade_left.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.fade-bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 380px;
    background-image: url("project://database/Assets/_Game/Art/UI/fade_bottom.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.dim {
    background-color: rgba(14, 19, 20, 0.9);
}

.panel {
    background-color: rgba(14, 19, 20, 0.95);
    background-image: url("project://database/Assets/_Game/Art/UI/Texture/panel.png");
    background-repeat: repeat;
    background-size: 256px 256px;
    -unity-background-image-tint-color: rgba(190, 190, 190, 0.94);
    border-top-width: 2px;
    border-top-color: rgb(191, 158, 92);
}

/* Main screen */

.main-column {
    position: absolute;
    left: 120px;
    top: 44px;
    width: 600px;
}

.title-emblem {
    width: 70px;
    height: 87px;
    margin: 0 0 6px 4px;
}

.title-divider {
    width: 330px;
    height: 42px;
    margin: 0 0 18px -6px;
}

.root .title {
    -unity-font-definition: url("project://database/Assets/_Game/Art/Fonts/CormorantSC-Bold.ttf");
    font-size: 88px;
    color: rgb(191, 158, 92);
    letter-spacing: 2px;
}

.root .tagline {
    font-size: 15px;
    letter-spacing: 4px;
    color: rgb(185, 185, 160);
    margin: 10px 0 12px 4px;
}

.menu-list {
    width: 380px;
}

.root .menu-button {
    height: 46px;
    margin: 0 0 4px 0;
    padding: 0 20px;
    border-width: 0;
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(222, 222, 191);
    font-size: 24px;
    -unity-text-align: middle-left;
    transition-duration: 0.12s;
}

.root .menu-button:hover,
.root .menu-button:focus {
    padding-left: 30px;
    background-color: rgba(191, 158, 92, 0.16);
    border-left-color: rgb(191, 158, 92);
    color: rgb(241, 235, 210);
}

.root .menu-button:disabled {
    color: rgb(138, 138, 120);
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
}

.root .menu-meta {
    position: absolute;
    right: 16px;
    top: 0;
    bottom: 0;
    font-size: 14px;
    color: rgb(150, 150, 130);
    -unity-text-align: middle-right;
}

.root .menu-button:disabled .menu-meta {
    display: none;
}

.root .menu-button--center {
    -unity-text-align: middle-center;
    border-left-width: 0;
    font-size: 20px;
    height: 50px;
}

.root .corner {
    position: absolute;
    bottom: 44px;
    font-size: 14px;
    color: rgb(138, 138, 120);
}

.corner--left {
    left: 120px;
}

.corner--right {
    right: 48px;
}

/* Sub-pages */

.page {
    flex-grow: 1;
    padding: 64px 120px;
}

.page-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
}

.root .page-title {
    -unity-font-definition: url("project://database/Assets/_Game/Art/Fonts/CormorantSC-Bold.ttf");
    font-size: 60px;
    color: rgb(191, 158, 92);
}

.root .link-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(222, 222, 191);
    font-size: 18px;
    transition-duration: 0.12s;
}

.root .link-button:hover,
.root .link-button:focus {
    color: rgb(232, 199, 126);
    background-color: rgba(0, 0, 0, 0);
}

.root .caption {
    font-size: 14px;
    letter-spacing: 2px;
    color: rgb(185, 185, 160);
    margin-bottom: 10px;
}

.root .gold-button {
    height: 56px;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgb(191, 158, 92);
    color: rgb(14, 19, 20);
    font-size: 21px;
    -unity-font-definition: url("project://database/Assets/_Game/Art/Fonts/PT_Sans-Web-Bold.ttf");
    transition-duration: 0.12s;
}

.root .gold-button:hover,
.root .gold-button:focus {
    background-color: rgb(214, 182, 118);
}

.root .gold-button--small {
    height: 48px;
    padding: 0 40px;
    font-size: 18px;
}

.root .ghost-button {
    height: 48px;
    padding: 0 28px;
    margin: 0 12px 0 0;
    border-width: 1px;
    border-color: rgb(58, 65, 64);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(222, 222, 191);
    font-size: 18px;
}

.root .ghost-button:hover,
.root .ghost-button:focus {
    border-color: rgb(191, 158, 92);
    background-color: rgba(0, 0, 0, 0);
}

/* Scenario */

.scenario-body {
    flex-direction: row;
    flex-grow: 1;
}

.scenario-list {
    width: 340px;
    margin-right: 32px;
}

.scenario-item {
    padding: 16px 18px;
    margin-bottom: 8px;
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
}

.scenario-item--active {
    background-color: rgba(191, 158, 92, 0.14);
    border-left-color: rgb(191, 158, 92);
}

.root .item-title {
    font-size: 21px;
    color: rgb(241, 235, 210);
}

.root .item-meta {
    font-size: 15px;
    color: rgb(185, 185, 160);
    margin-top: 4px;
}

.root .scenario-item--locked .item-title,
.root .scenario-item--locked .item-meta {
    color: rgb(138, 138, 120);
}

.scenario-card {
    flex-grow: 1;
}

.card-art {
    height: 360px;
    background-image: url("project://database/Assets/_Game/Art/UI/scenario_frontier.png");
    -unity-background-scale-mode: scale-and-crop;
}

.card-body {
    flex-direction: row;
    flex-grow: 1;
    padding: 28px 32px;
}

.card-text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 40px;
}

.root .card-title {
    -unity-font-definition: url("project://database/Assets/_Game/Art/Fonts/CormorantSC-Bold.ttf");
    font-size: 40px;
    color: rgb(241, 235, 210);
    margin-bottom: 12px;
}

.root .body-text {
    white-space: normal;
    font-size: 19px;
    margin-bottom: 14px;
}

.card-side {
    width: 300px;
    justify-content: flex-end;
}

.card-side .unity-toggle {
    margin: 0 0 16px 0;
}

.root .card-side .unity-base-field__label {
    min-width: 0;
    flex-grow: 1;
}

/* Loading */

.loading-content {
    position: absolute;
    left: 120px;
    right: 120px;
    bottom: 64px;
}

.loading-emblem {
    width: 46px;
    height: 57px;
    margin-right: 18px;
}

.root .loading-row .loading-title {
    flex-grow: 1;
}

.loading-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 18px;
}

.root .loading-title {
    -unity-font-definition: url("project://database/Assets/_Game/Art/Fonts/CormorantSC-Bold.ttf");
    font-size: 48px;
    color: rgb(241, 235, 210);
}

.loading-bar {
    height: 4px;
    background-color: rgb(42, 49, 50);
    margin-bottom: 20px;
}

.loading-fill {
    height: 4px;
    width: 0;
    background-color: rgb(191, 158, 92);
}

.root .loading-tip {
    max-width: 920px;
}

/* About */

.about-panel {
    padding: 32px;
    max-width: 960px;
}

/* Pause */

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 11, 12, 0.78);
    align-items: center;
    justify-content: center;
}

.pause-panel {
    width: 420px;
    padding: 30px 40px 32px 40px;
}

.pause-emblem {
    width: 58px;
    height: 72px;
    align-self: center;
    margin-bottom: 2px;
}

.pause-divider {
    width: 260px;
    align-self: center;
    margin: 2px 0 0 0;
}

.root .pause-title {
    -unity-font-definition: url("project://database/Assets/_Game/Art/Fonts/CormorantSC-Bold.ttf");
    font-size: 48px;
    color: rgb(191, 158, 92);
    -unity-text-align: middle-center;
}

.root .pause-subtitle {
    -unity-text-align: middle-center;
    margin: 4px 0 22px 0;
}

.root .pause-note {
    font-size: 14px;
    color: rgb(138, 138, 120);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 18px;
}

/* Settings */

.tabs {
    flex-direction: row;
    border-bottom-width: 1px;
    border-color: rgb(42, 49, 50);
    margin-bottom: 24px;
}

.root .tab {
    height: 48px;
    padding: 0 24px;
    margin: 0 4px 0 0;
    border-width: 0;
    border-bottom-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(185, 185, 160);
    font-size: 18px;
}

.root .tab:hover {
    color: rgb(241, 235, 210);
    background-color: rgba(191, 158, 92, 0.08);
}

.root .tab:focus {
    color: rgb(241, 235, 210);
}

.root .tab--active {
    background-color: rgba(191, 158, 92, 0.14);
    border-bottom-color: rgb(191, 158, 92);
    color: rgb(241, 235, 210);
}

.settings-page {
    padding: 28px 32px;
    max-width: 960px;
}

.root .setting {
    margin: 0 0 18px 0;
}

.root .unity-base-field__label {
    min-width: 300px;
    color: rgb(222, 222, 191);
    font-size: 18px;
    -unity-text-align: middle-left;
}

.root .unity-base-popup-field__input {
    height: 40px;
    padding: 0 10px;
    border-color: rgb(58, 65, 64);
    border-radius: 0;
    background-color: rgb(22, 30, 31);
}

.root .unity-base-popup-field__text {
    color: rgb(241, 235, 210);
    font-size: 17px;
}

.root .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(191, 158, 92);
}

.root .unity-toggle__checkmark {
    width: 22px;
    height: 22px;
    border-color: rgb(58, 65, 64);
    background-color: rgb(22, 30, 31);
    -unity-background-image-tint-color: rgb(191, 158, 92);
}

.root .unity-base-slider__tracker {
    background-color: rgb(42, 49, 50);
    border-color: rgb(58, 65, 64);
}

.root .unity-base-slider__dragger {
    background-color: rgb(191, 158, 92);
    border-color: rgb(191, 158, 92);
}

.control-row {
    flex-direction: row;
    padding: 9px 0;
    border-bottom-width: 1px;
    border-color: rgb(34, 42, 43);
}

.root .control-action {
    width: 340px;
}

.root .control-keys {
    color: rgb(241, 235, 210);
}

.page-footer {
    max-width: 960px;
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 24px;
}

/* Confirm dialog */

.confirm-panel {
    width: 560px;
    padding: 30px 36px 28px 36px;
}

.root .confirm-title {
    -unity-font-definition: url("project://database/Assets/_Game/Art/Fonts/CormorantSC-Bold.ttf");
    font-size: 38px;
    color: rgb(191, 158, 92);
    margin-bottom: 12px;
}

.confirm-buttons {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 12px;
}

/* Save slots */

.slots-body {
    flex-grow: 1;
    max-width: 1100px;
}

.root .slots-new {
    align-self: flex-start;
    margin-bottom: 18px;
}

.slot-list {
    flex-grow: 1;
}

.slot-row {
    flex-direction: row;
    align-items: center;
    padding: 14px 18px;
    margin-bottom: 6px;
    background-color: rgba(14, 19, 20, 0.95);
    border-left-width: 3px;
    border-left-color: rgb(58, 65, 64);
}

.slot-row:hover {
    border-left-color: rgb(191, 158, 92);
    background-color: rgba(191, 158, 92, 0.1);
}

.slot-info {
    flex-grow: 1;
    flex-shrink: 1;
}

.root .slot-row .link-button {
    margin-left: 8px;
    color: rgb(185, 185, 160);
}

.root .slot-row .link-button:hover {
    color: rgb(230, 110, 85);
}

.slots-empty {
    padding: 28px 32px;
}

/* Results */

.results-screen {
    align-items: center;
    justify-content: center;
}

.results-art {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/_Game/Art/UI/results_victory.png");
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(150, 150, 150);
}

.results-art--defeat {
    background-image: url("project://database/Assets/_Game/Art/UI/results_defeat.png");
}

.results-panel {
    width: 860px;
    padding: 28px 44px 32px 44px;
    background-color: rgba(10, 14, 15, 0.9);
}

.results-emblem {
    width: 64px;
    height: 80px;
    align-self: center;
}

.results-divider {
    width: 360px;
    align-self: center;
    margin-bottom: 4px;
}

.root .results-title {
    -unity-font-definition: url("project://database/Assets/_Game/Art/Fonts/CormorantSC-Bold.ttf");
    font-size: 72px;
    color: rgb(191, 158, 92);
    -unity-text-align: middle-center;
    letter-spacing: 4px;
}

.root .results-title--defeat {
    color: rgb(196, 72, 48);
}

.root .results-title,
.root .pause-title,
.root .title {
    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.85);
}

.root .results-subtitle {
    -unity-text-align: middle-center;
    color: rgb(185, 185, 160);
    margin: 4px 0 22px 0;
}

.results-stats {
    margin-bottom: 26px;
}

.results-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 7px 0;
    border-bottom-width: 1px;
    border-color: rgb(34, 42, 43);
}

.root .results-name {
    font-size: 17px;
    color: rgb(185, 185, 160);
}

.root .results-value {
    font-size: 17px;
    color: rgb(241, 235, 210);
    -unity-font-definition: url("project://database/Assets/_Game/Art/Fonts/PT_Sans-Web-Bold.ttf");
}

.results-buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.root .results-buttons .ghost-button {
    padding: 0 20px;
}

/* Art. Icons are 256 px squares from tools/art_gen.py. */

.icon-res_wood { background-image: url("project://database/Assets/_Game/Art/UI/Icons/res_wood.png"); }
.icon-res_stone { background-image: url("project://database/Assets/_Game/Art/UI/Icons/res_stone.png"); }
.icon-res_food { background-image: url("project://database/Assets/_Game/Art/UI/Icons/res_food.png"); }
.icon-unit_swordsman { background-image: url("project://database/Assets/_Game/Art/UI/Icons/unit_swordsman.png"); }
.icon-unit_worker { background-image: url("project://database/Assets/_Game/Art/UI/Icons/unit_worker.png"); }
.icon-unit_wagon { background-image: url("project://database/Assets/_Game/Art/UI/Icons/unit_wagon.png"); }
.icon-unit_wolf { background-image: url("project://database/Assets/_Game/Art/UI/Icons/unit_wolf.png"); }
.icon-unit_ashen { background-image: url("project://database/Assets/_Game/Art/UI/Icons/unit_ashen.png"); }
.icon-unit_store { background-image: url("project://database/Assets/_Game/Art/UI/Icons/unit_store.png"); }
.icon-cmd_build { background-image: url("project://database/Assets/_Game/Art/UI/Icons/cmd_build.png"); }
.icon-cmd_recruit { background-image: url("project://database/Assets/_Game/Art/UI/Icons/cmd_recruit.png"); }
.icon-cmd_crew { background-image: url("project://database/Assets/_Game/Art/UI/Icons/cmd_crew.png"); }
.icon-cmd_raid { background-image: url("project://database/Assets/_Game/Art/UI/Icons/cmd_raid.png"); }
.icon-cmd_bury { background-image: url("project://database/Assets/_Game/Art/UI/Icons/cmd_bury.png"); }
.icon-cmd_burn { background-image: url("project://database/Assets/_Game/Art/UI/Icons/cmd_burn.png"); }
.icon-cmd_hide { background-image: url("project://database/Assets/_Game/Art/UI/Icons/cmd_hide.png"); }
.icon-cmd_carry { background-image: url("project://database/Assets/_Game/Art/UI/Icons/cmd_carry.png"); }
.icon-cmd_drop { background-image: url("project://database/Assets/_Game/Art/UI/Icons/cmd_drop.png"); }
.icon-cmd_escort { background-image: url("project://database/Assets/_Game/Art/UI/Icons/cmd_escort.png"); }
.icon-cmd_route { background-image: url("project://database/Assets/_Game/Art/UI/Icons/cmd_route.png"); }
.icon-cmd_halt { background-image: url("project://database/Assets/_Game/Art/UI/Icons/cmd_halt.png"); }

/* Codex */

.codex-list {
    width: 340px;
    margin-right: 32px;
}

.root .codex-item {
    flex-direction: row;
    align-items: center;
    height: 58px;
    margin: 0 0 6px 0;
    padding: 0 12px;
    border-width: 0;
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(222, 222, 191);
    font-size: 19px;
    -unity-text-align: middle-left;
}

.root .codex-item:hover,
.root .codex-item:focus {
    background-color: rgba(191, 158, 92, 0.1);
}

.root .codex-item--active {
    background-color: rgba(191, 158, 92, 0.16);
    border-left-color: rgb(191, 158, 92);
    color: rgb(241, 235, 210);
}

.codex-item-icon {
    width: 40px;
    height: 40px;
    margin-right: 14px;
    border-width: 1px;
    border-color: rgb(80, 70, 50);
    -unity-background-scale-mode: scale-and-crop;
}

.root .codex-caption {
    margin: 14px 0 8px 0;
}

.codex-card {
    flex-grow: 1;
    align-self: flex-start;
    flex-direction: row;
    padding: 32px;
    align-items: flex-start;
}

.codex-art {
    width: 280px;
    height: 280px;
    margin-right: 36px;
    border-width: 1px;
    border-color: rgb(191, 158, 92);
    -unity-background-scale-mode: scale-and-crop;
}

.codex-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.root .codex-meta {
    color: rgb(191, 158, 92);
    margin-bottom: 4px;
}

.codex-divider {
    width: 260px;
    margin: 4px 0 14px -20px;
}

/* Main menu on short logical heights (interface scale above 115%) */

.menu--short .title-emblem {
    display: none;
}

.menu--short .title {
    font-size: 64px;
}

.menu--short .menu-button {
    height: 40px;
    font-size: 21px;
}

.menu--short .page {
    padding: 36px 80px;
}

/* Scene fades (UiFx.FadeIn / FadeOut) */

.fader {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(4, 6, 7);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out;
}

.fader--on {
    opacity: 1;
}

/* Staggered entrance (UiFx.Stagger); keeps the quick hover transitions of the menu buttons */

.root .stagger-item {
    transition-property: opacity, translate, background-color, border-color, color, padding-left;
    transition-duration: 0.5s, 0.5s, 0.12s, 0.12s, 0.12s, 0.16s;
    transition-timing-function: ease-out-cubic, ease-out-cubic, ease, ease, ease, ease-out;
}

/* Continue card on the main menu */

.root .continue-card {
    position: absolute;
    right: 48px;
    bottom: 84px;
    width: 420px;
    height: 104px;
    margin: 0;
    padding: 10px;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-color: rgba(191, 158, 92, 0.5);
    border-radius: 0;
    background-color: rgba(10, 14, 15, 0.82);
    transition-duration: 0.15s;
}

.root .continue-card:hover {
    border-color: rgb(191, 158, 92);
    background-color: rgba(26, 32, 30, 0.92);
    translate: 0 -3px;
}

.continue-thumb {
    width: 148px;
    height: 83px;
    margin-right: 16px;
    border-width: 1px;
    border-color: rgb(80, 70, 50);
    background-color: rgb(20, 28, 29);
    -unity-background-scale-mode: scale-and-crop;
}

.continue-info {
    flex-grow: 1;
}

.root .continue-info .unity-label {
    -unity-text-align: upper-left;
    white-space: normal;
}

.root .continue-info .caption {
    margin-bottom: 2px;
    color: rgb(191, 158, 92);
}

/* Save slot thumbnails */

.slot-thumb {
    width: 128px;
    height: 72px;
    margin-right: 18px;
    border-width: 1px;
    border-color: rgb(80, 70, 50);
    background-color: rgb(20, 28, 29);
    -unity-background-scale-mode: scale-and-crop;
}

/* Mission briefing (PauseMenu.uxml, BriefingView) */

.briefing {
    background-color: rgb(6, 9, 10);
}

.briefing-art {
    background-image: url("project://database/Assets/_Game/Art/UI/scenario_frontier.png");
}

.briefing-shade {
    opacity: 0.92;
}

.briefing-body {
    position: absolute;
    left: 120px;
    top: 110px;
    width: 760px;
}

.root .briefing-chapter {
    color: rgb(191, 158, 92);
    letter-spacing: 4px;
    margin-bottom: 4px;
}

.root .briefing-title {
    -unity-font-definition: url("project://database/Assets/_Game/Art/Fonts/CormorantSC-Bold.ttf");
    font-size: 78px;
    color: rgb(241, 235, 210);
    text-shadow: 0 3px 12px rgba(0, 0, 0, 0.9);
}

.briefing-divider {
    width: 330px;
    height: 42px;
    margin: 0 0 18px -6px;
}

.root .briefing-text {
    font-size: 23px;
    color: rgb(232, 226, 200);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
}

.briefing-card {
    position: absolute;
    right: 100px;
    bottom: 96px;
    width: 440px;
    padding: 26px 30px 24px 30px;
}

.briefing-goal {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.root .briefing-goal .unity-label {
    font-size: 19px;
    white-space: normal;
    flex-shrink: 1;
}

.root .briefing-start {
    margin-top: 14px;
}

.root .briefing-skip {
    -unity-text-align: middle-center;
    margin-top: 10px;
}

.briefing-goal .objective-mark {
    width: 9px;
    height: 9px;
    margin-right: 14px;
    border-width: 1px;
    border-color: rgb(191, 158, 92);
    rotate: 45deg;
}
